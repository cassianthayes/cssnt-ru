---
import { actions, isInputError } from "astro:actions";
import { MESSAGE_MAX_LENGTH } from "../lib/message";

// Set when the form is posted: the page re-renders with the outcome.
const result = Astro.getActionResult(actions.sendMessage);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const errorMessage = result?.error
    ? (inputErrors.body?.[0] ??
      result.error.message ??
      "Could not send your message.")
    : null;
---

<section aria-label="Anonymous message">
    <form
        id="message-form"
        method="POST"
        action={actions.sendMessage}
        data-sent={result && !result.error ? "true" : undefined}
        class="flex flex-col gap-2"
    >
        <div class="flex gap-2">
            <label for="message-body" class="sr-only">Anonymous message</label>
            <input
                id="message-body"
                name="body"
                type="text"
                required
                maxlength={MESSAGE_MAX_LENGTH}
                placeholder="Anonymous message"
                class="min-w-0 flex-1 rounded border border-zinc-800 bg-transparent px-2 py-1.5 text-sm text-white placeholder:text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            />
            <button
                type="submit"
                class="shrink-0 rounded border border-zinc-700 px-2 py-1.5 text-white hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-40"
            >
                {/* Heroicons, paper airplane (solid). */}
                <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M3.478 2.404a.75.75 0 0 0-.926.941l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.404Z"
                    ></path>
                </svg>
                <span class="sr-only">Send</span>
            </button>
        </div>
        {
            result && !result.error && (
                <p role="status" class="text-xs text-zinc-500">
                    Message sent.
                </p>
            )
        }
        {
            errorMessage && (
                <p role="alert" class="text-xs text-red-400">
                    {errorMessage}
                </p>
            )
        }
    </form>
</section>

<script>
    const COOLDOWN_MS = 10_000;
    const STORAGE_KEY = "cssnt-ru:message-cooldown";

    const form = document.querySelector<HTMLFormElement>("#message-form");
    const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");
    const label = button?.querySelector<HTMLSpanElement>("span");

    // A successful post re-renders the page, so the deadline has to survive the
    // reload; without JavaScript the form still posts plainly.
    function readDeadline(): number {
        try {
            return Number(sessionStorage.getItem(STORAGE_KEY)) || 0;
        } catch {
            return 0;
        }
    }

    function saveDeadline(deadline: number): void {
        try {
            sessionStorage.setItem(STORAGE_KEY, String(deadline));
        } catch {
            // Where storage is blocked, the button only locks while submitting.
        }
    }

    let deadline = readDeadline();
    let timer: number | undefined;

    function applyLock(): void {
        if (!button || !label) return;

        const left = deadline - Date.now();
        const seconds = Math.ceil(left / 1000);

        button.disabled = left > 0;
        button.title = left > 0 ? `Wait ${seconds}s` : "";
        label.textContent = left > 0 ? `Wait ${seconds}s` : "Send";

        if (left > 0 && timer === undefined) {
            timer = window.setInterval(applyLock, 500);
        } else if (left <= 0 && timer !== undefined) {
            window.clearInterval(timer);
            timer = undefined;
        }
    }

    // Only a delivered message starts the wait; a rejected one can be retried at once.
    if (form?.dataset.sent) {
        deadline = Date.now() + COOLDOWN_MS;
        saveDeadline(deadline);
    }

    applyLock();

    form?.addEventListener("submit", (event) => {
        // A second click while the first post is in flight would send twice.
        if (!button || button.disabled) {
            event.preventDefault();
            return;
        }

        button.disabled = true;
    });
</script>
