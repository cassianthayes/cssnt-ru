---
import { actions, isInputError } from "astro:actions";
import { MESSAGE_MAX_LENGTH } from "../lib/message";

// Set when the form is posted: the page re-renders with the outcome.
const result = Astro.getActionResult(actions.sendMessage);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const errorMessage = result?.error
    ? (inputErrors.body?.[0] ??
      result.error.message ??
      "Could not send your message.")
    : null;
---

<section aria-label="Anonymous message">
    <form
        id="message-form"
        method="POST"
        action={actions.sendMessage}
        class="flex flex-col gap-2"
    >
        <div class="flex gap-2">
            <label for="message-body" class="sr-only">Anonymous message</label>
            <input
                id="message-body"
                name="body"
                type="text"
                required
                maxlength={MESSAGE_MAX_LENGTH}
                placeholder="Anonymous message"
                class="min-w-0 flex-1 rounded border border-zinc-800 bg-transparent px-2 py-1.5 text-sm text-white placeholder:text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            />
            <button
                type="submit"
                class="shrink-0 rounded border border-zinc-700 px-2 py-1.5 text-white hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-40"
            >
                {/* Heroicons, paper airplane (solid). */}
                <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M3.478 2.404a.75.75 0 0 0-.926.941l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.404Z"
                    ></path>
                </svg>
                <span class="sr-only">Send</span>
            </button>
        </div>
        {
            result && !result.error && (
                <p role="status" class="text-xs text-zinc-500">
                    Message sent.
                </p>
            )
        }
        {
            errorMessage && (
                <p role="alert" class="text-xs text-red-400">
                    {errorMessage}
                </p>
            )
        }
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>("#message-form");
    const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

    // The post navigates away, so this only stops a second click, or Enter, while the
    // first request is still in flight. Without JavaScript the form posts plainly.
    form?.addEventListener("submit", (event) => {
        if (!button || button.disabled) {
            event.preventDefault();
            return;
        }

        button.disabled = true;
    });
</script>
