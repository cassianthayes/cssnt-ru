---
import { env } from "cloudflare:workers";
import { fetchPinnedRepositories } from "../lib/github";
import SectionHeading from "./SectionHeading.astro";

const repositories = await fetchPinnedRepositories(env.GITHUB_TOKEN);
---

<section aria-labelledby="projects-heading">
    <SectionHeading id="projects-heading" label="Projects" />

    {
        repositories === null ? (
            <p class="text-sm text-zinc-500">
                Pinned projects are unavailable right now.
            </p>
        ) : (
            <div class="grid gap-3 sm:grid-cols-2">
                {repositories.map((repository) => (
                    <a
                        href={`https://github.com/cassianthayes/${repository.name}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    >
                        <h3 class="font-semibold text-white">
                            {repository.name} <span aria-hidden="true">↗</span>
                        </h3>
                        <p class="text-sm text-zinc-400">{repository.description}</p>
                    </a>
                ))}
            </div>
        )
    }
</section>
