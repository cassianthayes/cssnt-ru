---
// Buttons are grouped by purpose: the sites and communities of the people around
// the site, then the software it is built and run with, the generator behind the
// images, and last the image-only statements.
const buttons = [
    {
        href: "https://tetopie.lol/",
        src: "/buttons/tetodev.gif",
        alt: "Tetodev",
    },
    {
        href: "https://senko.digital/",
        src: "/buttons/senko-digital.png",
        alt: "Senko Digital",
    },
    {
        href: "https://t.me/meowmeowmeowvpn",
        src: "/buttons/meowvpn.png",
        alt: "MeowVPN",
    },
    {
        href: "https://www.mozilla.org/firefox/",
        src: "/buttons/firefox2.gif",
        alt: "Firefox",
    },
    {
        href: "https://www.deepseek.com/",
        src: "/buttons/deepseek.png",
        alt: "DeepSeek",
    },
    {
        href: "https://opencode.ai/",
        src: "/buttons/opencode.png",
        alt: "Powered by opencode",
    },
    {
        href: "https://88x31.datakra.sh/",
        src: "/buttons/datakrash-generator.png",
        alt: "88x31 Button Generator by Datakrash",
    },
    { href: undefined, src: "/buttons/hatems.jpg", alt: "I hate Microsoft" },
    { href: undefined, src: "/buttons/noweb3.gif", alt: "Say no to Web3" },
    { href: undefined, src: "/buttons/nodurevvpn.gif", alt: "No Durev VPN" },
    { href: undefined, src: "/buttons/portal.jpg", alt: "Portal" },
];
---

<nav aria-label="Links" class="flex flex-wrap justify-center gap-2">
    {buttons.map((button) =>
        button.href ? (
            <a href={button.href} target="_blank" rel="noopener noreferrer">
                <img
                    src={button.src}
                    alt={button.alt}
                    class="relative inline-block transition-transform duration-150 [image-rendering:pixelated] hover:z-10 hover:scale-150"
                    width="88"
                    height="31"
                />
            </a>
        ) : (
            <img
                src={button.src}
                alt={button.alt}
                class="relative inline-block transition-transform duration-150 [image-rendering:pixelated] hover:z-10 hover:scale-150"
                width="88"
                height="31"
            />
        ),
    )}
</nav>
