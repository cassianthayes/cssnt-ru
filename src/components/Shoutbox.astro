<section id="shoutbox" aria-labelledby="shoutbox-title" class="mt-10">
    <h2 id="shoutbox-title" class="text-sm font-semibold text-white">
        Shoutbox
    </h2>

    <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div>
            <p id="shoutbox-empty" class="text-sm text-zinc-500">Loading…</p>
            <ol
                id="shoutbox-list"
                hidden
                class="max-h-80 divide-y divide-zinc-800 overflow-y-auto rounded border border-zinc-800"
            >
            </ol>
        </div>

        <form id="shoutbox-form" class="flex flex-col gap-2">
            <noscript>
                <p class="text-sm text-zinc-500">
                    The shoutbox needs JavaScript to send messages.
                </p>
            </noscript>
            <input
                name="author"
                type="text"
                maxlength="40"
                autocomplete="nickname"
                placeholder="Name (optional)"
                class="rounded border border-zinc-800 bg-transparent px-2 py-1.5 text-sm text-white placeholder:text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            />
            <textarea
                name="body"
                required
                maxlength="500"
                rows="4"
                placeholder="Message"
                class="resize-none rounded border border-zinc-800 bg-transparent px-2 py-1.5 text-sm text-white placeholder:text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            ></textarea>
            <button
                type="submit"
                class="self-start rounded border border-zinc-700 px-3 py-1.5 text-sm text-white hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-50"
            >
                Send
            </button>
            <p
                id="shoutbox-status"
                role="status"
                class="text-xs text-zinc-500"
            ></p>
        </form>
    </div>
</section>

<script>
    interface PublishedMessage {
        author: string | null;
        body: string;
        createdAt: string;
    }

    const list = document.querySelector<HTMLOListElement>("#shoutbox-list");
    const empty = document.querySelector<HTMLParagraphElement>("#shoutbox-empty");
    const form = document.querySelector<HTMLFormElement>("#shoutbox-form");
    const status = document.querySelector<HTMLParagraphElement>("#shoutbox-status");

    if (list && empty && form && status) {
        void loadMessages(list, empty);
        form.addEventListener("submit", (event) => {
            event.preventDefault();
            void sendMessage(form, status);
        });
    }

    async function loadMessages(
        list: HTMLOListElement,
        empty: HTMLParagraphElement,
    ): Promise<void> {
        try {
            const response = await fetch("/api/messages");
            if (!response.ok) throw new Error(String(response.status));

            const { messages } = (await response.json()) as {
                messages: PublishedMessage[];
            };

            list.replaceChildren(...messages.map(createItem));
            list.hidden = messages.length === 0;
            empty.hidden = messages.length > 0;
            empty.textContent = "No messages yet.";
        } catch {
            empty.textContent = "Could not load messages.";
        }
    }

    async function sendMessage(
        form: HTMLFormElement,
        status: HTMLParagraphElement,
    ): Promise<void> {
        const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
        const data = new FormData(form);

        button?.toggleAttribute("disabled", true);
        status.textContent = "Sending…";

        try {
            const response = await fetch("/api/messages", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({
                    author: data.get("author"),
                    body: data.get("body"),
                }),
            });

            const result = (await response.json().catch(() => null)) as {
                error?: string;
            } | null;

            if (!response.ok) {
                status.textContent = result?.error ?? "Could not send your message.";
                return;
            }

            form.reset();
            status.textContent = "Thanks — your message appears once it is approved.";
        } catch {
            status.textContent = "Could not send your message.";
        } finally {
            button?.toggleAttribute("disabled", false);
        }
    }

    function createItem(message: PublishedMessage): HTMLLIElement {
        const item = document.createElement("li");
        item.className = "px-3 py-2";

        const header = document.createElement("p");
        header.className = "flex items-baseline gap-2";

        const author = document.createElement("span");
        author.className = "text-sm font-semibold text-white";
        author.textContent = message.author ?? "anonymous";

        const time = document.createElement("time");
        time.className = "text-xs text-zinc-500";
        time.dateTime = message.createdAt;
        time.textContent = formatDate(message.createdAt);

        const body = document.createElement("p");
        body.className = "mt-0.5 whitespace-pre-wrap break-words text-sm text-zinc-400";
        body.textContent = message.body;

        header.append(author, time);
        item.append(header, body);
        return item;
    }

    function formatDate(iso: string): string {
        const date = new Date(iso);
        if (Number.isNaN(date.getTime())) return iso;

        return date.toLocaleString(undefined, {
            dateStyle: "medium",
            timeStyle: "short",
        });
    }
</script>
