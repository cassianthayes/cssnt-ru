---
import { actions, isInputError } from "astro:actions";
import { env } from "cloudflare:workers";
import { listPublishedMessages } from "../lib/messages";
import { AUTHOR_MAX_LENGTH, BODY_MAX_LENGTH } from "../lib/shoutbox";

const messages = await listPublishedMessages(env.DB);

// Set when the visitor submitted the form without JavaScript: the page re-renders
// with the outcome of the action.
const result = Astro.getActionResult(actions.submitMessage);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const errorMessage = result?.error
    ? (inputErrors.body?.[0] ??
      inputErrors.author?.[0] ??
      result.error.message ??
      "Could not send your message.")
    : null;

function formatDate(iso: string): string {
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return iso;

    const pad = (value: number) => String(value).padStart(2, "0");

    return `${date.getUTCFullYear()}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())} ${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}`;
}
---

<section aria-label="Shoutbox" class="mt-10">
    <div class="grid gap-3 sm:grid-cols-3">
        <form
            id="shoutbox-form"
            method="POST"
            action={actions.submitMessage}
            class="flex flex-col gap-2 sm:order-2"
        >
            <input
                name="author"
                type="text"
                maxlength={AUTHOR_MAX_LENGTH}
                autocomplete="nickname"
                placeholder="Name (optional)"
                class="rounded border border-zinc-800 bg-transparent px-2 py-1.5 text-sm text-white placeholder:text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            />
            <textarea
                name="body"
                required
                maxlength={BODY_MAX_LENGTH}
                rows="4"
                placeholder="Message"
                class="resize-none rounded border border-zinc-800 bg-transparent px-2 py-1.5 text-sm text-white placeholder:text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            ></textarea>
            <button
                type="submit"
                class="self-start rounded border border-zinc-700 px-3 py-1.5 text-sm text-white hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-50"
            >
                Send
            </button>
            {
                result && !result.error && (
                    <p class="text-xs text-zinc-500">
                        Thanks — your message appears once it is approved.
                    </p>
                )
            }
            {
                errorMessage && (
                    <p class="text-xs text-red-400">{errorMessage}</p>
                )
            }
        </form>

        <div class="min-w-0 sm:order-1 sm:col-span-2">
            {
                messages.length === 0 ? (
                    <p class="text-sm text-zinc-500">No messages yet.</p>
                ) : (
                    <ol class="max-h-80 divide-y divide-zinc-800 overflow-y-auto rounded border border-zinc-800">
                        {messages.map((message) => (
                            <li
                                class:list={[
                                    "px-3 py-2",
                                    message.createdAt === null && "bg-zinc-900/60",
                                ]}
                            >
                                <p class="flex items-baseline gap-2">
                                    <span class="text-sm font-semibold text-white">
                                        {message.author ?? "anonymous"}
                                    </span>
                                    {message.createdAt ? (
                                        <time
                                            class="text-xs tabular-nums text-zinc-500"
                                            datetime={message.createdAt}
                                        >
                                            {formatDate(message.createdAt)}
                                        </time>
                                    ) : (
                                        <span
                                            class="text-xs"
                                            role="img"
                                            aria-label="Pinned"
                                            title="Pinned"
                                        >
                                            📌
                                        </span>
                                    )}
                                </p>
                                <p class="mt-0.5 whitespace-pre-wrap break-words text-sm text-zinc-400">
                                    {message.body}
                                </p>
                            </li>
                        ))}
                    </ol>
                )
            }
        </div>
    </div>
</section>

<script>
    import { actions, isInputError } from "astro:actions";

    const form = document.querySelector<HTMLFormElement>("#shoutbox-form");

    // Without JavaScript the form posts to the action and the page re-renders with
    // the outcome. This only turns that outcome into an alert.
    form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const { error } = await actions.submitMessage(new FormData(form));

        if (error) {
            const firstInputError = isInputError(error)
                ? Object.values(error.fields).flat()[0]
                : undefined;

            alert(firstInputError ?? error.message ?? "Could not send your message.");
            return;
        }

        form.reset();
        alert("Thanks — your message appears once it is approved.");
    });

    // Ctrl+Enter, or Cmd+Enter on macOS, sends the message from the textarea while
    // plain Enter still adds a new line.
    form?.querySelector("textarea")?.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) {
            event.preventDefault();
            form.requestSubmit();
        }
    });
</script>
