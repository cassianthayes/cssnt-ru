// Cloudflare Worker configuration. The Astro adapter supplies the entrypoint and
// the static asset binding; only the project name lives here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cssnt-ru",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "cssnt.ru", "custom_domain": true }]
}
