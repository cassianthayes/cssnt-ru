{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
      "dev": "astro dev",
      "build": "astro build",
      "preview": "astro preview",
      "deploy": "bun run build && wrangler deploy",
      "db:migrate": "wrangler d1 migrations apply cssnt-ru-shoutbox --remote",
      "db:migrate:local": "wrangler d1 migrations apply cssnt-ru-shoutbox --local",
      "db:seed:local": "wrangler d1 execute cssnt-ru-shoutbox --local --file seed/local.sql",
      "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "wrangler": "^4.162.0"
  }
}